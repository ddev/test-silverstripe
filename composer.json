{
    "name": "ddev/test-silverstripe",
    "type": "project",
    "description": "A basic Silverstripe CMS installation for testing DDEV",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-cms": "^6",
        "silverstripe/startup-theme": "^1",
        "silverstripe/login-forms": "^6",
        "silverstripe/htmleditor-tinymce": "^1"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
